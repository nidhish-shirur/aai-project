# Copy this file to ".env" and fill in your key. NEVER commit .env to Git.

LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=paste_your_groq_key_here
# Model names change over time. If you get "model not found", open
# https://console.groq.com/docs/models and paste a current model ID here.
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback provider (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Number shown in emergency guidance (112 is the all-India emergency number)
EMERGENCY_NUMBER=112

# Upper limit of follow-up questions per session. Fallback mode asks one field per
# question (a protocol has up to ~12 required fields), so 15 is the safe default.
MAX_QUESTIONS=15
# Seconds to wait for one model call before falling back to the fixed question order (default 12)
LLM_TIMEOUT_S=12
# Optional PIN for the clinician dashboard (leave empty for a local demo)
DASHBOARD_PIN=
