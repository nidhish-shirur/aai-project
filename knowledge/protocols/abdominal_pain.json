{
  "id": "abdominal_pain",
  "title": "Abdominal (stomach) pain",
  "triggers": [
    "abdominal",
    "stomach pain",
    "stomach ache",
    "belly",
    "tummy",
    "pet dard",
    "pet mein dard"
  ],
  "fields": [
    {
      "key": "pain_location",
      "type": "enum",
      "required": true,
      "options": [
        "upper",
        "lower_right",
        "lower_left",
        "central",
        "all_over",
        "unsure"
      ],
      "question": "Where is the pain: upper, lower right, lower left, around the belly button, or all over?",
      "description": "Main location of the abdominal pain."
    },
    {
      "key": "abdomen_rigid",
      "type": "bool",
      "required": true,
      "question": "Is the belly hard like a board, or very painful to touch?",
      "description": "Is the belly hard like a board, or very painful to touch?"
    },
    {
      "key": "vomiting_blood",
      "type": "bool",
      "required": true,
      "question": "Are you vomiting blood or passing black tarry stools?",
      "description": "Are you vomiting blood or passing black tarry stools?"
    },
    {
      "key": "vomiting",
      "type": "bool",
      "required": true,
      "question": "Any vomiting?",
      "description": "Any vomiting?"
    },
    {
      "key": "fever",
      "type": "bool",
      "required": true,
      "question": "Any fever?",
      "description": "Any fever?"
    },
    {
      "key": "blood_in_stool",
      "type": "bool",
      "required": true,
      "question": "Any blood in the stool?",
      "description": "Any blood in the stool?"
    },
    {
      "key": "vaginal_bleeding",
      "type": "bool",
      "required": true,
      "question": "Any vaginal bleeding?",
      "description": "Any vaginal bleeding?",
      "ask_if": "pregnant"
    }
  ],
  "red_flags": [
    {
      "id": "abd_rigid",
      "label": "Hard, very painful abdomen",
      "when": "abdomen_rigid",
      "category": "medical"
    },
    {
      "id": "abd_vomit_blood",
      "label": "Vomiting blood or black stools",
      "when": "vomiting_blood",
      "category": "medical"
    },
    {
      "id": "abd_pregnant_bleeding",
      "label": "Abdominal pain with vaginal bleeding in possible pregnancy",
      "when": {
        "all": [
          "pregnant",
          "vaginal_bleeding"
        ]
      },
      "category": "medical"
    }
  ],
  "rules": [
    {
      "id": "abd_severe",
      "urgency": "urgent",
      "when": [
        "severity",
        "==",
        "severe"
      ],
      "reason": "The person rates the pain as severe."
    },
    {
      "id": "abd_right_lower",
      "urgency": "urgent",
      "when": {
        "all": [
          [
            "pain_location",
            "==",
            "lower_right"
          ],
          {
            "any": [
              "fever",
              "vomiting"
            ]
          }
        ]
      },
      "reason": "Pain in the lower right abdomen with fever or vomiting needs same-day assessment."
    },
    {
      "id": "abd_blood_stool",
      "urgency": "urgent",
      "when": "blood_in_stool",
      "reason": "Blood in the stool needs same-day assessment."
    },
    {
      "id": "abd_pregnant",
      "urgency": "urgent",
      "when": "pregnant",
      "reason": "Abdominal pain in possible pregnancy needs same-day assessment."
    },
    {
      "id": "abd_fever",
      "urgency": "moderate",
      "when": "fever",
      "reason": "Abdominal pain with fever should be reviewed by a doctor."
    },
    {
      "id": "abd_vomit_day",
      "urgency": "moderate",
      "when": {
        "all": [
          "vomiting",
          [
            "duration_days",
            ">=",
            1
          ]
        ]
      },
      "reason": "Vomiting with abdominal pain lasting a day or more."
    },
    {
      "id": "abd_three_days",
      "urgency": "moderate",
      "when": [
        "duration_days",
        ">=",
        3
      ],
      "reason": "Abdominal pain lasting three days or more."
    },
    {
      "id": "abd_moderate",
      "urgency": "moderate",
      "when": [
        "severity",
        "==",
        "moderate"
      ],
      "reason": "The person rates the pain as moderate."
    }
  ],
  "default_urgency": "low",
  "warning_signs": [
    "Severe or worsening pain",
    "Hard, rigid belly",
    "Vomiting blood",
    "Black stools",
    "Fever",
    "Unable to keep fluids down"
  ],
  "min_urgency_if_incomplete": "moderate",
  "source_notes": [
    "Rules are student-authored from the general principles in public triage guidance (NHS emergency advice, ESI handbook, WHO emergency triage). Source clause references still to be added; NOT clinically validated."
  ]
}
